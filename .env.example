NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (use a separate database/user per environment)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/p-learning?retryWrites=true&w=majority

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Used to build password-reset links
FRONTEND_URL=http://localhost:5173

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx/ingress)
TRUST_PROXY=0

# Global rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter limit shared by login/register/forgot/reset/change-password (per IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Auth. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30
# lax/strict for same-site deployments; none (requires HTTPS) if frontend and API are on different sites
COOKIE_SAMESITE=lax
